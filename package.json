{
  "name": "hush",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "The web is loud. hush turns it down. A free, open-source extension that calms X, YouTube and Roblox.",
  "scripts": {
    "build": "vite build --config ui/vite.config.ts",
    "dev": "vite build --config ui/vite.config.ts --watch",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.5",
    "@fontsource-variable/geist-mono": "^5.2.5",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "motion": "^14.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.37.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/chrome": "^0.0.304",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.9",
    "tw-animate-css": "^1.2.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/save/hush.git"
  },
  "bugs": {
    "url": "https://github.com/save/hush/issues"
  },
  "homepage": "https://github.com/save/hush#readme"
}
