{
  "manifest_version": 3,
  "name": "hush",
  "short_name": "hush",
  "version": "0.6.0",
  "description": "Turn the volume down on the web. Calm, minimal versions of the sites you use every day.",
  "permissions": [
    "storage",
    "activeTab",
    "favicon",
    "contextMenus"
  ],
  "action": {
    "default_title": "hush",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Toggle hush on the current site"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "css": [
        "src/core/generic.css"
      ],
      "js": [
        "src/core/registry.js",
        "src/core/icons.js",
        "src/core/palette.js",
        "src/sites/x.js",
        "src/sites/youtube.js",
        "src/sites/roblox.js",
        "src/sites/github.js",
        "src/sites/reddit.js",
        "src/core/picker.js",
        "src/core/engine.js"
      ]
    },
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "src/sites/x.css"
      ]
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "src/sites/youtube.css"
      ]
    },
    {
      "matches": [
        "*://www.roblox.com/*",
        "*://roblox.com/*",
        "*://web.roblox.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "src/sites/roblox.css"
      ]
    },
    {
      "matches": [
        "*://github.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "src/sites/github.css"
      ]
    },
    {
      "matches": [
        "*://www.reddit.com/*",
        "*://reddit.com/*",
        "*://new.reddit.com/*",
        "*://sh.reddit.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "src/sites/reddit.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "build/popup/index.html",
    "open_in_tab": true
  }
}
